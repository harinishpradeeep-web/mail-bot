# ──────────────────────────────────────────────────────────────
# Mail Scheduler — environment variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is git-ignored. Never commit real values.
# ──────────────────────────────────────────────────────────────


# ==============================================================
# PUBLIC VARIABLES  (safe to expose to the browser)
# Anything prefixed NEXT_PUBLIC_ is inlined into client JS.
# Never put a secret here.
# ==============================================================

# Base URL of this app. Used to build OAuth redirect URIs and links.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ==============================================================
# SECRET / SERVER-ONLY VARIABLES
# These are read only inside /app/api/** and /lib/** on the server.
# They are never imported into a client component.
# ==============================================================

# ---- Google OAuth 2.0 ----------------------------------------
# WHERE TO GET THESE: Google Cloud Console → APIs & Services → Credentials
#   → Create Credentials → OAuth client ID → Application type: "Web application"
# Full walkthrough: see GMAIL_SETUP.md (Steps 1–6).

# YOU MUST FILL THIS IN — looks like 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# YOU MUST FILL THIS IN — looks like GOCSPX-xxxxxxxxxxxxxxxxxxxx
# Server-only. Never send this to the frontend.
GOOGLE_CLIENT_SECRET=

# YOU MUST FILL THIS IN — must match EXACTLY one of the
# "Authorised redirect URIs" you registered in Google Cloud Console.
# This is the callback route this app actually implements:
#   app/api/auth/google/callback/route.ts
# Local:      http://localhost:3000/api/auth/google/callback
# Production: https://your-app.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


# ---- App secrets ---------------------------------------------
# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Encrypts Google refresh tokens at rest in the database (AES-256-GCM).
# Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: if you change this, every stored Gmail connection must reconnect.
TOKEN_ENCRYPTION_KEY=

# Shared secret protecting the scheduler endpoint /api/cron/send-due.
# Any caller must send:  Authorization: Bearer <CRON_SECRET>
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=


# ---- Database ------------------------------------------------
# NeonDB PostgreSQL connection string
# Format: postgres://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=


# ---- Development scheduler -----------------------------------
# In `next dev` the app calls its own /api/cron/send-due every 30s, so
# scheduled email works without a second terminal. Never runs in production —
# there, real cron calls that endpoint. Set to false to drive it yourself with
# `npm run cron:local`. Requires CRON_SECRET and, on a non-3000 port,
# NEXT_PUBLIC_APP_URL pointing at your dev server.
ENABLE_DEV_SCHEDULER=true


# ---- Sending mode --------------------------------------------
# real  → emails are actually sent through the Gmail API
# mock  → nothing leaves the machine; sends are logged as if successful
# Automated tests always force mock regardless of this value.
MAIL_MODE=real
