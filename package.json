{
  "name": "mail-scheduler",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:all": "npm run dev & npm run cron:local",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "cron:local": "tsx scripts/run-cron-local.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/functions": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "luxon": "^3.5.0",
    "next": "14.2.15",
    "pg": "^8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
